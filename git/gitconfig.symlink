[core]
  excludesfile = ~/.gitignore
  pager = less -R -X
  editor = nvim

[user]
  name = Richard Hart
  email = richard@richardhart.me

[github]
  user = richardhartme

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[fetch]
  prune = true

[rebase]
  autoStash = true

[merge]
  conflictstyle = zdiff3

[diff]
  colorMoved = default

[alias]
  s = status
  st = status -sb
  c = commit
  a = add
  di = diff
  dic = diff --cached
  pl = pull
  plre = pull --rebase
  ph = push
  out = log @{u}..HEAD
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit
